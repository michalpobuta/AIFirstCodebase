{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet run --file \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-tests.cs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dotnet run --file \"${CLAUDE_PROJECT_DIR}/.claude/hooks/verify.cs\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
